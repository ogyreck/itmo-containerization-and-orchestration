token: "{{ k3s_token }}"
tls-san:
  - "{{ k3s_tls_san }}"

{% if k3s_cluster_init %}
cluster-init: true
{% endif %}

{% if k3s_disable_components %}
disable:
{% for component in k3s_disable_components %}
  - {{ component }}
{% endfor %}
{% endif %}


{% if k3s_isolate_control_plane %}
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"
{% endif %}
